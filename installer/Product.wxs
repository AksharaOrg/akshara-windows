<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Akshara" Manufacturer="AksharaOrg" Version="$(var.Version)"
           UpgradeCode="70E682A1-9D31-45A5-A345-3676F71B6B60" Scope="perMachine" Compressed="yes">
    <SummaryInformation Description="Akshara Sinhala input method for Windows" Manufacturer="AksharaOrg" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Akshara is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AksharaIcon" SourceFile="..\assets\windows\Akshara.ico" />
    <Property Id="ARPPRODUCTICON" Value="AksharaIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/AksharaOrg/akshara-windows/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/AksharaOrg/akshara-windows" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="X64ROOT" Name="Akshara">
        <Directory Id="X64DIR" Name="x64" />
        <Directory Id="LEGACYHELPDIR" Name="help" />
        <Directory Id="SETTINGSDIR" Name="settings" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="X86ROOT" Name="Akshara">
        <Directory Id="X86DIR" Name="x86" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="MenuDir" Name="Akshara" /></StandardDirectory>

    <ComponentGroup Id="Payload">
      <Component Directory="X64DIR" Id="X64Tip" Guid="A64D534D-51D5-443E-87DE-7302466250E8" Bitness="always64">
        <File Id="X64Dll" Source="$(var.PayloadRoot)\x64\AksharaIME.dll" KeyPath="yes" />
        <File Id="X64Register" Source="$(var.PayloadRoot)\x64\AksharaRegister.exe" />
      </Component>
      <Component Directory="X86DIR" Id="X86Tip" Guid="8FFB882F-6BF5-4FCE-904C-A1041F82D290" Bitness="always32">
        <File Id="X86Dll" Source="$(var.PayloadRoot)\x86\AksharaIME.dll" KeyPath="yes" />
        <File Id="X86Register" Source="$(var.PayloadRoot)\x86\AksharaRegister.exe" />
      </Component>
      <Component Directory="SETTINGSDIR" Id="SettingsApp" Guid="9150B4DB-B2C0-44A0-9DD6-0DF08B7D1FF8" Bitness="always64">
        <File Id="SettingsExe" Source="$(var.PayloadRoot)\x64\AksharaSettings.exe" KeyPath="yes">
          <Shortcut Id="SettingsShortcut" Directory="MenuDir" Name="Akshara" WorkingDirectory="SETTINGSDIR" Advertise="yes" />
        </File>
        <RemoveFolder Id="RemoveMenuDir" Directory="MenuDir" On="uninstall" />
        <!-- These files predate the single-app installer and therefore are
             not owned by this MSI. Remove them during every upgrade. -->
        <RemoveFile Id="RemoveLegacyHelpExe" Directory="LEGACYHELPDIR" Name="AksharaHelp.exe" On="install" />
        <RemoveFolder Id="RemoveLegacyHelpDirectory" Directory="LEGACYHELPDIR" On="install" />
        <RemoveFile Id="RemoveLegacyHelpShortcut" Directory="MenuDir" Name="Akshara Help.lnk" On="install" />
      </Component>
    </ComponentGroup>

    <CustomAction Id="RegisterX64" FileRef="X64Register" ExeCommand='install &quot;[X64DIR]AksharaIME.dll&quot;' Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RegisterX86" FileRef="X86Register" ExeCommand='install &quot;[X86DIR]AksharaIME.dll&quot;' Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackRegisterX64" FileRef="X64Register" ExeCommand='uninstall &quot;[X64DIR]AksharaIME.dll&quot;' Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="RollbackRegisterX86" FileRef="X86Register" ExeCommand='uninstall &quot;[X86DIR]AksharaIME.dll&quot;' Execute="rollback" Impersonate="no" Return="ignore" />
    <!-- A stale diagnostics handle must not prevent an IME upgrade. The helper
         still removes the log when possible; a later activation safely appends
         a new one if another process holds the previous file open. -->
    <CustomAction Id="ClearInstallingUserDiagnostics" FileRef="X64Register" ExeCommand="clear-log" Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="EnableSmartForInstallingUser" FileRef="X64Register" ExeCommand="enable smart" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="UnregisterX64" FileRef="X64Register" ExeCommand='uninstall &quot;[X64DIR]AksharaIME.dll&quot;' Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="UnregisterX86" FileRef="X86Register" ExeCommand='uninstall &quot;[X86DIR]AksharaIME.dll&quot;' Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="UnregisterX86" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UnregisterX64" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RollbackRegisterX64" Before="RegisterX64" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="RegisterX64" After="InstallFiles" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="RollbackRegisterX86" Before="RegisterX86" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="RegisterX86" After="RegisterX64" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="ClearInstallingUserDiagnostics" After="RegisterX86" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="EnableSmartForInstallingUser" After="ClearInstallingUserDiagnostics" Condition="NOT Installed OR REINSTALL" />
    </InstallExecuteSequence>
    <Feature Id="Complete" Title="Akshara" Level="1"><ComponentGroupRef Id="Payload" /></Feature>
  </Package>
</Wix>
