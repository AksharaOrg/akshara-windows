<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Akshara.Settings.Pages.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="36,8,36,36" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Smart Phonetic typing guide" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Type Sinhala by sound with English letters. Grammar-correct Smart Phonetic spells each word by the rules of Sinhala orthography, and Space picks the dictionary spelling."
                TextWrapping="Wrap" />
            <StackPanel x:Name="Sections" Spacing="{StaticResource SettingsCardSpacing}" />
        </StackPanel>
    </ScrollViewer>
</Page>
